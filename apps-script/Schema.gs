// ---------------------------------------------------------------------------
// setupWorkbook
// ---------------------------------------------------------------------------

function setupWorkbook() {
  const ss = SpreadsheetApp.getActive();
  const specs = tabSpecs();

  ensureSettingsTab_(ss);
  specs.forEach(spec => ensureTab_(ss, spec));
  ensureScenarioRows_(ss);
  ensureReadmeTab_(ss);

  // Named ranges must exist before validation and formulas reference them.
  buildNamedRanges_(ss);
  specs.forEach(spec => {
    applyValidation_(ss, spec);
    applyFormulas_(ss, spec);
  });

  applyConditionalFormatting_(ss);
  specs.filter(s => s.owned).forEach(s => protectTab_(ss.getSheetByName(s.name)));
  orderTabs_(ss, specs);

  SpreadsheetApp.getActive().toast('Workbook created / repaired.', 'MCP Demo Seeder', 5);
}

function ensureTab_(ss, spec) {
  let sh = ss.getSheetByName(spec.name);
  if (!sh) sh = ss.insertSheet(spec.name);
  reconcileHeaders_(sh, spec.cols);

  sh.setFrozenRows(1);
  const width = spec.cols.length;
  const header = sh.getRange(1, 1, 1, width);
  header.setFontWeight('bold').setBackground('#1d4ed8').setFontColor('#ffffff').setVerticalAlignment('middle');
  sh.setRowHeight(1, 30);
  spec.cols.forEach((c, i) => {
    if (c.w) sh.setColumnWidth(i + 1, c.w);
    const cell = sh.getRange(1, i + 1);
    if (c.note) cell.setNote(c.note);
    if (c.f) cell.setBackground('#475569'); // computed columns read as "don't type here"
  });
  if (sh.getMaxRows() < LAST_ROW) sh.insertRowsAfter(sh.getMaxRows(), LAST_ROW - sh.getMaxRows());
  return sh;
}

/**
 * Restores columns someone deleted, without disturbing their data. If a spec header is missing
 * entirely we insert a column in the right position; extra trailing columns are left alone so
 * people can keep their own scratch notes.
 */
function reconcileHeaders_(sh, cols) {
  if (sh.getMaxColumns() < cols.length) {
    sh.insertColumnsAfter(sh.getMaxColumns(), cols.length - sh.getMaxColumns());
  }
  for (let i = 0; i < cols.length; i++) {
    const existing = sh.getRange(1, 1, 1, sh.getMaxColumns()).getValues()[0].map(v => String(v).trim());
    if (existing[i] === cols[i].h) continue;
    // A non-empty header we don't recognise here means a column was deleted and everything
    // shifted left — reinsert, so the row's data lines up with its headers again.
    if (existing[i] !== '' && existing.indexOf(cols[i].h) === -1) sh.insertColumnBefore(i + 1);
    sh.getRange(1, i + 1).setValue(cols[i].h);
  }
  // Assert the spec headers, so a renamed header snaps back.
  sh.getRange(1, 1, 1, cols.length).setValues([cols.map(c => c.h)]);
}

/** Seeds one row per scenario the first time, so ownership is visible from day one. */
function ensureScenarioRows_(ss) {
  const sh = ss.getSheetByName(TAB.SCENARIOS);
  if (sh.getLastRow() > 1) return;   // never overwrite what people have filled in
  sh.getRange(2, 1, 3, 6).setValues([
    ['uc1', 'Customer Onboarding Health', '', '', 'testing',
     'In-flight accounts behind on required training, plus an established cohort that proves the correlation.'],
    ['uc2', 'Knowledge Gaps vs Support Tickets', '', '', 'designing',
     'Ticket categories with no course are the content roadmap. Depends on the deliberate gaps staying empty.'],
    ['uc3', 'Upsell and Renewal Readiness', '', '', 'designing',
     'Learners taking courses outside their plan tier, with a renewal approaching.']
  ]);
}

function ensureSettingsTab_(ss) {
  let sh = ss.getSheetByName(TAB.SETTINGS);
  if (!sh) sh = ss.insertSheet(TAB.SETTINGS);
  sh.getRange(1, 1, 1, 3).setValues([['key', 'value', 'notes']])
    .setFontWeight('bold').setBackground('#1d4ed8').setFontColor('#ffffff');
  sh.setFrozenRows(1);
  sh.setColumnWidth(1, 210).setColumnWidth(2, 220).setColumnWidth(3, 560);

  const existing = {};
  const last = Math.max(sh.getLastRow(), 1);
  if (last > 1) {
    sh.getRange(2, 1, last - 1, 2).getValues().forEach((r, i) => {
      if (String(r[0]).trim()) existing[String(r[0]).trim()] = { value: r[1], row: i + 2 };
    });
  }
  let row = last + 1;
  SETTINGS_DEFAULTS.forEach(([key, dflt, note]) => {
    if (existing[key]) {
      sh.getRange(existing[key].row, 3).setValue(note); // notes are ours; values are theirs
      return;
    }
    sh.getRange(row, 1, 1, 3).setValues([[key, dflt, note]]);
    row++;
  });

  applyListValidation_(sh, 'environment', ENUM.ENVIRONMENT);
  applyListValidation_(sh, 't_anchor_mode', ENUM.ANCHOR_MODE);
  applyListValidation_(sh, 'active_use_case', ENUM.USE_CASE_SCOPE);
}

function applyListValidation_(settingsSheet, key, values) {
  const rows = settingsSheet.getRange(2, 1, Math.max(settingsSheet.getLastRow() - 1, 1), 1).getValues();
  for (let i = 0; i < rows.length; i++) {
    if (String(rows[i][0]).trim() === key) {
      settingsSheet.getRange(i + 2, 2).setDataValidation(
        SpreadsheetApp.newDataValidation().requireValueInList(values, true).setAllowInvalid(false).build());
      return;
    }
  }
}

function buildNamedRanges_(ss) {
  const settings = ss.getSheetByName(TAB.SETTINGS);
  const keys = settings.getRange(2, 1, Math.max(settings.getLastRow() - 1, 1), 1).getValues()
    .map(r => String(r[0]).trim());
  const settingCell = key => {
    const i = keys.indexOf(key);
    return i === -1 ? null : settings.getRange(i + 2, 2);
  };

  const ranges = {
    AccountsAll: ss.getSheetByName(TAB.ACCOUNTS).getRange(2, 1, LAST_ROW - 1, 18),
    AccountsKeyDomain: ss.getSheetByName(TAB.ACCOUNTS).getRange(2, 1, LAST_ROW - 1, 4),
    AccountKeys: ss.getSheetByName(TAB.ACCOUNTS).getRange(2, 1, LAST_ROW - 1, 1),
    EnrollAccount: ss.getSheetByName(TAB.ENROLLMENTS).getRange(2, 3, LAST_ROW - 1, 1),
    EnrollCount: ss.getSheetByName(TAB.ENROLLMENTS).getRange(2, 7, LAST_ROW - 1, 1),
    EnrollCompleted: ss.getSheetByName(TAB.ENROLLMENTS).getRange(2, 8, LAST_ROW - 1, 1),
    GroupTitlePrefix: settingCell('group_title_prefix'),
    CourseRefPrefix: settingCell('course_ref_prefix')
  };

  const byName = {};
  ss.getNamedRanges().forEach(nr => { byName[nr.getName()] = nr; });
  Object.keys(ranges).forEach(name => {
    if (!ranges[name]) return;
    if (byName[name]) byName[name].setRange(ranges[name]);
    else ss.setNamedRange(name, ranges[name]);
  });
}

function applyValidation_(ss, spec) {
  const sh = ss.getSheetByName(spec.name);
  spec.cols.forEach((c, i) => {
    const range = sh.getRange(2, i + 1, LAST_ROW - 1, 1);
    if (c.f || spec.owned) { range.clearDataValidations(); return; }
    let rule = null;
    if (c.list) {
      rule = SpreadsheetApp.newDataValidation().requireValueInList(c.list, true).setAllowInvalid(false)
        .setHelpText('One of: ' + c.list.join(', ')).build();
    } else if (c.check) {
      rule = SpreadsheetApp.newDataValidation().requireCheckbox().build();
    } else if (c.ref) {
      const src = ss.getSheetByName(c.ref[0]).getRange(2, c.ref[1], LAST_ROW - 1, 1);
      rule = SpreadsheetApp.newDataValidation().requireValueInRange(src, true).setAllowInvalid(false)
        .setHelpText('Must match a key on the ' + c.ref[0] + ' tab').build();
    }
    if (rule) range.setDataValidation(rule); else range.clearDataValidations();
  });
}

function applyFormulas_(ss, spec) {
  const sh = ss.getSheetByName(spec.name);
  spec.cols.forEach((c, i) => {
    if (!c.f) return;
    const formulas = [];
    for (let r = 2; r <= LAST_ROW; r++) formulas.push([c.f.replace(/\{r\}/g, String(r))]);
    sh.getRange(2, i + 1, formulas.length, 1).setFormulas(formulas);
  });
}

function applyConditionalFormatting_(ss) {
  // _Validation: errors red, warnings amber.
  const v = ss.getSheetByName(TAB.VALIDATION);
  v.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('error')
      .setBackground('#fee2e2').setFontColor('#991b1b')
      .setRanges([v.getRange(2, 1, LAST_ROW - 1, 6)]).build(),
    SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('warning')
      .setBackground('#fef3c7').setFontColor('#92400e')
      .setRanges([v.getRange(2, 1, LAST_ROW - 1, 6)]).build()
  ]);

  // Accounts: flag when the number the demo will actually show drifts from the intended one.
  const a = ss.getSheetByName(TAB.ACCOUNTS);
  a.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=AND(LEN($N2)>0,LEN($O2)>0,ABS($N2-$O2)>2)')
      .setBackground('#fee2e2').setFontColor('#991b1b')
      .setRanges([a.getRange(2, 14, LAST_ROW - 1, 2)]).build()
  ]);

  // TicketCategories: deliberate gaps must be visually obvious so nobody fills one in by accident.
  const tc = ss.getSheetByName(TAB.TICKET_CATEGORIES);
  tc.setConditionalFormatRules([
    SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied('=$D2=TRUE')
      .setBackground('#ede9fe').setFontColor('#5b21b6')
      .setRanges([tc.getRange(2, 1, LAST_ROW - 1, 5)]).build()
  ]);
}

function protectTab_(sh) {
  if (!sh) return;
  sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(p => p.remove());
  sh.protect().setDescription('Script-owned. Do not edit by hand.').setWarningOnly(true);
  sh.setTabColor('#94a3b8');
}

function orderTabs_(ss, specs) {
  const order = [TAB.README, TAB.SETTINGS].concat(specs.map(s => s.name));
  order.forEach((name, i) => {
    const sh = ss.getSheetByName(name);
    if (!sh) return;
    ss.setActiveSheet(sh);
    ss.moveActiveSheet(i + 1);
  });
  ss.setActiveSheet(ss.getSheetByName(TAB.README));
}

// ---------------------------------------------------------------------------
// README
// ---------------------------------------------------------------------------

function ensureReadmeTab_(ss) {
  let sh = ss.getSheetByName(TAB.README);
  if (!sh) sh = ss.insertSheet(TAB.README);
  sh.clear();
  sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(p => p.remove());
  sh.setColumnWidth(1, 940);
  sh.setHiddenGridlines(true);

  const blocks = [
    ['MCP Demo Data Seeder', 'h1'],
    ['Seeds, refreshes and safely removes demo data in LearnUpon (HubSpot later) so an AI assistant querying them via MCP can answer questions about training-driven outcomes.', 'p'],

    ['How to run a seed', 'h2'],
    ['1.  Setup -> Create / Repair Workbook  (safe to re-run any time)\n' +
     '2.  Setup -> Set Credentials, then Check Credentials\n' +
     '3.  Author the reference tabs, or Setup -> Load Example Scenario (UC1)\n' +
     '4.  Validate  -- seeding is blocked while any error exists\n' +
     '5.  Preview (dry run)  -- writes the full plan to _Preview without touching any platform\n' +
     '6.  Seed, one phase at a time  (added in a later build phase)', 'pre'],

    ['The T-scale convention', 'h2'],
    ['Dates are never typed literally. They are offsets from an anchor, resolved when you run:\n\n' +
     '   T, T+n, T-n     the global anchor (today, or Settings.t_anchor_date when pinned)\n' +
     '   S, S+n, S-n     that account\'s onboarding start date\n' +
     '   G, G+n, G-n     that account\'s target go-live date\n\n' +
     'Any offset cell also accepts a range, written A..B, e.g.  G-40..G-5\n' +
     'Each record gets its own date inside that window, so overdue counts emerge from the data\n' +
     'instead of being declared. Same seed = same dates, every time.', 'pre'],

    ['What each tab is for', 'h2'],
    ['Settings           environment, anchor mode, seed, custom-field labels\n' +
     'Accounts           the companies. Headcount, cohort, onboarding and go-live dates\n' +
     'People             named personas only. Fillers are generated, not listed\n' +
     'Courses            the required training, and which course to clone from\n' +
     'Enrollments        one row per account x course: how many complete, in progress, not started\n' +
     'PersonaStates      pin a named person to a specific state, e.g. "Dana has not started"\n' +
     'TicketCategories   ticket taxonomy, including the deliberate content gaps\n' +
     'Tickets, Deals     authored now, inert until HubSpot is connected', 'pre'],

    ['Columns with a dark grey header are computed', 'h3'],
    ['Do not type in them — Create / Repair Workbook will overwrite whatever you put there. Notably, People.email is computed from first name, last name and the account domain. A hand-typed email that does not match its HubSpot contact would silently break the cross-system join and would probably survive until demo day.', 'p'],

    ['Tabs beginning with an underscore are script-owned', 'h3'],
    ['_Manifest is the ledger of every record we created, and the ONLY authority for deletion. Reset never searches a platform for things to delete — if a record is not in the manifest, it is not touched. Read it before authorizing a reset.', 'p'],

    ['Two portals', 'h2'],
    ['Settings.environment selects which portal writes go to: "test" for the throwaway portal, "demo" for ACME. Credentials for both live in Script Properties. Every write dialog tells you which portal it is about to hit — read it.', 'p'],

    ['Credentials access caveat', 'h3'],
    ['Credentials are stored in Script Properties, never in a cell. But anyone with edit access to this sheet can open the script editor and read them. That is an accepted trade-off for demo-portal credentials shared among the project team — it is recorded here so it is not a surprise.', 'p'],

    ['Safety guarantees', 'h2'],
    ['Reset deletes enrollments and nothing else. Users, groups, memberships and courses are created once and are never removed by this toolkit. No code path can delete a user, or any record absent from _Manifest. Deletes verify the record\'s tag first and skip anything that fails the check.', 'p'],

    ['One invariant worth knowing', 'h3'],
    ['A seeded user must never be enrolled in a course outside their use case\'s required set. The demo computes "percent of required training complete" from a group-filtered progress report, so a stray enrollment silently changes every percentage in the story.', 'p']
  ];

  let row = 1;
  blocks.forEach(([text, kind]) => {
    const cell = sh.getRange(row, 1);
    cell.setValue(text).setVerticalAlignment('top');
    if (kind === 'h1') cell.setFontSize(20).setFontWeight('bold').setFontColor('#1d4ed8');
    if (kind === 'h2') cell.setFontSize(14).setFontWeight('bold').setFontColor('#1e293b');
    if (kind === 'h3') cell.setFontSize(11).setFontWeight('bold').setFontColor('#334155');
    if (kind === 'p') cell.setWrap(true).setFontColor('#334155');
    if (kind === 'pre') cell.setFontFamily('Courier New').setFontSize(10).setFontColor('#0f172a');
    row += (kind === 'h1' || kind === 'h2') ? 2 : 1;
    if (kind === 'p' || kind === 'pre') row += 1;
  });
  sh.setTabColor('#1d4ed8');
}
