/**
 * Schema.gs — the workbook is generated by code.
 *
 * setupWorkbook() is idempotent: it creates missing tabs, restores deleted columns, rewrites
 * formula columns, reapplies dropdowns, conditional formatting and protection, and never destroys
 * user-entered rows. Running it twice is harmless.
 *
 * Column ORDER is part of the contract — the formulas below reference columns positionally.
 */

const TAB = {
  README: 'README',
  SETTINGS: 'Settings',
  SCENARIOS: 'Scenarios',
  ACCOUNTS: 'Accounts',
  PEOPLE: 'People',
