  DEALS: 'Deals',
  MANIFEST: '_Manifest',
  VALIDATION: '_Validation',
  LOG: '_Log',
  PREVIEW: '_Preview'
};

/** Last row of the authored data ranges. 200 data rows is far more than any scenario needs. */
const LAST_ROW = 201;

const ENUM = {
  USE_CASE: ['uc1', 'uc2', 'uc3'],
  // "all" exists for the person doing a full ACME seed. Day to day, everyone works in their own
  // scenario so that Reset and Refresh cannot reach across into someone else's data.
  USE_CASE_SCOPE: ['uc1', 'uc2', 'uc3', 'all'],
  SCENARIO_STATUS: ['designing', 'seeding', 'testing', 'ready'],
